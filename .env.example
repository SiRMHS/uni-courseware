# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uni_courseware?schema=public"

# Express API Server
API_PORT=4000
API_HOST=0.0.0.0

# FTP Connection (all paths resolved dynamically via DB metadata)
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=ftpuser
FTP_PASSWORD=changeme
FTP_SECURE=false
FTP_POOL_SIZE=5
FTP_BASE_ROOT=/
FTP_PUBLIC_DOMAIN=https://your-cdn-domain.com
# Optional: path to lftp binary for bulk mirror operations
# LFTP_BIN=/usr/local/bin/lftp

# JWT Secret
JWT_SECRET=change-this-to-a-random-secret

# Next.js Web App
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_MODULE_KEY=
WEB_PORT=3000

# Optional seed data (JSON — no hardcoded paths in source code)
# SEED_MODULES='[{"type":"LIBRARY_BOOK","name":"کتابخانه مرکزی","systemKey":"central-library","ftpBaseRoot":"/library","items":[{"title":"منابع عمومی","slug":"general","relativeFtpPath":"general"}]}]'
# SEED_FOLDER_CONFIGS='[{"targetPath":"central-library","lmsMode":true}]'
