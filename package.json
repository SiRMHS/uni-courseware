{
  "name": "uni-courseware",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:generate": "npm run generate --workspace=@uni/database",
    "db:migrate": "npm run migrate --workspace=@uni/database",
    "db:seed": "npm run seed --workspace=@uni/database",
    "db:studio": "npm run studio --workspace=@uni/database"
  },
  "packageManager": "npm@11.5.2",
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@videojs/react": "^10.0.0-beta.24",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0"
  }
}
