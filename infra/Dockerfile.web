FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache openssl ca-certificates

# ۱. کپی کردن فایل‌های اصلی مونو-ریپو
COPY package.json package-lock.json turbo.json ./

# ۲. کپی کردن پکیج‌جیسون‌های تمام پوشه‌ها به صورت مجزا (حیاتی برای تحلیل ورک‌اسپیس)
COPY apps/api-server/package.json ./apps/api-server/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/database/package.json ./packages/database/package.json

# ۳. کپی کردن پکیج‌های مشترک داخلی
COPY packages/ ./packages/

# ۴. نصب پکیج‌ها با اینترنت آزاد گیت‌هاب
RUN npm install --include=dev --legacy-peer-deps

# ۵. تولید کلاینت دیتابیس
RUN npm run db:generate

# ۶. کپی کردن کدهای اصلی وب‌اپلیکیشن
COPY apps/web/ ./apps/web/

ENV NEXT_PUBLIC_API_URL=http://api:4000
RUN npx turbo run build --filter=@uni/web

FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl ca-certificates

COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json
COPY --from=builder /app/apps/web/next.config.js ./apps/web/next.config.js
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000
WORKDIR /app/apps/web
CMD ["npx", "next", "start", "--port", "3000"]