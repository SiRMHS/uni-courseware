# ===== Production Environment Variables =====
# Copy this file to .env.prod and fill in your values

# Database
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@db:5432/uni_courseware?schema=public
DB_PASSWORD=change-this-to-a-strong-password

# API Server
API_PORT=4000
API_HOST=0.0.0.0

# JWT
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# FTP (optional - for file uploads)
FTP_HOST=your-ftp-host.com
FTP_PORT=21
FTP_USER=your-ftp-user
FTP_PASSWORD=your-ftp-password
FTP_SECURE=false
FTP_POOL_SIZE=5
FTP_BASE_ROOT=/domains/your-domain.com/public_html
FTP_PUBLIC_DOMAIN=https://your-cdn-domain.com

# Web App
NEXT_PUBLIC_API_URL=http://api:4000
WEB_PORT=3000

# Prisma (for migrations)
PRISMA_SCHEMA_DIR=packages/database/prisma
